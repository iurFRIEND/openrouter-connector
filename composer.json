{
	"name": "iurfriend/openrouter_connector",
	"description": "Connect the Nextcloud Assistant to hundreds of AI models through OpenRouter",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "iurFRIEND",
			"email": "it@iurfriend.com"
		}
	],
	"require": {
		"php": "^8.2 || ^8.3 || ^8.4 || ^8.5"
	},
	"require-dev": {
		"nextcloud/coding-standard": "^1.4",
		"nextcloud/ocp": "^34.0",
		"phpunit/phpunit": "^11.5",
		"psalm/phar": "^6.0"
	},
	"autoload": {
		"psr-4": {
			"OCA\\OpenRouterConnector\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\OpenRouterConnector\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"scripts": {
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm.phar --no-cache --threads=1",
		"psalm:update-baseline": "psalm.phar --no-cache --threads=1 --update-baseline",
		"test:unit": "phpunit --config tests/phpunit.xml"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		}
	}
}
