<psalm
	errorLevel="4"
	findUnusedBaselineEntry="true"
	findUnusedIssueHandlerSuppression="false"
	findUnusedCode="false"
	resolveFromConfigFile="true"
	phpVersion="8.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
	<projectFiles>
		<directory name="lib" />
		<ignoreFiles>
			<directory name="vendor" />
		</ignoreFiles>
	</projectFiles>
	<extraFiles>
		<directory name="vendor" />
	</extraFiles>
	<issueHandlers>
		<LessSpecificReturnStatement errorLevel="error"/>
		<LessSpecificReturnType errorLevel="error"/>
		<LessSpecificImplementedReturnType errorLevel="error"/>
		<MoreSpecificReturnType errorLevel="error"/>
		<!-- Task types of newer server versions; the ProviderFactory only
		     builds their providers where the class exists. Against the newest
		     supported version nothing is left to suppress, which is why
		     findUnusedIssueHandlerSuppression is off. -->
		<UndefinedClass>
			<errorLevel type="suppress">
				<referencedClass name="OCP\TaskProcessing\TaskTypes\TextToTextReformatParagraphs"/>
				<referencedClass name="OCP\TaskProcessing\TaskTypes\TextToTextImprove"/>
			</errorLevel>
		</UndefinedClass>
	</issueHandlers>
</psalm>
